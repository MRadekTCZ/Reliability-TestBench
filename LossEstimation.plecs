        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#define VHs 3.0f;\n"
"//100 thermal constants\n"
"float Rth1 = 1.424;\n"
"float Cth1 = 0.78*VHs;\n"
"float Rth2 = 0.00709;\n"
"float Cth2 = 15.78*VHs;\n"
"float Rth3 = 0.61;\n"
"float Cth3 = 10.23*VHs;\n"
"float Rth4 = 5.5;\n"
"float Cth4 = 200.0;\n"
"float Tambient = 25.0f;\n"
"float Ts = 0.01f;\n"
"\n"
"\n"
"#include <stdint.h>\n"
"\n"
"typedef struct\n"
"{\n"
"    float a1;\n"
"    float b1;\n"
"    float a2;\n"
"    float b2;\n"
"    float a3;\n"
"    float b3;\n"
"    float a4;\n"
"    float b4;\n"
"    float Tambient;\n"
"} ThermalParams;\n"
"\n"
"typedef struct\n"
"{\n"
"    float y1;\n"
"    float y2;\n"
"    float y3;\n"
"    float y4;\n"
"} ThermalState;\n"
"\n"
"void Thermal_Init(ThermalState *state,\n"
"                  ThermalParams *params,\n"
"                  float Rth1, float Cth1,\n"
"                  float Rth2, float Cth2,\n"
"                  float Rth3, float Cth3,\n"
"                  float Rth4, float Cth4,\n"
"                  float Tambient,\n"
"                  float Ts)\n"
"{\n"
"    float tau1 = Rth1 * Cth1;\n"
"    float tau2 = Rth2 * Cth2;\n"
"    float tau3 = Rth3 * Cth3;\n"
"    float tau4 = Rth4 * Cth4;\n"
"\n"
"    state->y1 = 0.0f;\n"
"    state->y2 = 0.0f;\n"
"    state->y3 = 0.0f;\n"
"    state->y4 = 0.0f;\n"
"\n"
"    params->a1 = tau1 / (tau1 + Ts);\n"
"    params->b1 = (Rth1 * Ts) / (tau1 + Ts);\n"
"\n"
"    params->a2 = tau2 / (tau2 + Ts);\n"
"    params->b2 = (Rth2 * Ts) / (tau2 + Ts);\n"
"\n"
"    params->a3 = tau3 / (tau3 + Ts);\n"
"    params->b3 = (Rth3 * Ts) / (tau3 + Ts);\n"
"\n"
"    params->a4 = tau4 / (tau4 + Ts);\n"
"    params->b4 = (Rth4 * Ts) / (tau4 + Ts);\n"
"\n"
"    params->Tambient = Tambient;\n"
"}\n"
"\n"
"float Thermal_Step(ThermalState *state, const ThermalParams *params, float Po"
"wer)\n"
"{\n"
"    state->y1 = params->a1 * state->y1 + params->b1 * Power;\n"
"    state->y2 = params->a2 * state->y2 + params->b2 * Power;\n"
"    state->y3 = params->a3 * state->y3 + params->b3 * Power;\n"
"    state->y4 = params->a4 * state->y4 + params->b4 * Power;\n"
"\n"
"    return params->Tambient + state->y1 + state->y2 + state->y3 + state->y4;"
"\n"
"}\n"
"\n"
"ThermalState s;\n"
"ThermalParams p;\n"
"float Power;\n"
"float Temperature;"
        Show          off
      }
