        Value         "[1 2]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[3 2 2]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "0.0001"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "\n"
"\n"
"#include <math.h>\n"
"#define PI 3.141592653f//;\n"
"#define one_by_sqrt6 0.40824829f\n"
"#define one_by_sqrt3 0.57735f\n"
"#define one_by_sqrt2 0.70710678f\n"
"#define sqrt2_by_sqrt3 0.816496581f\n"
"#define sqrt3 1.732050f\n"
"#define pi_by_3 1.04719755f\n"
"#define one_by_pi_by_3 0.9549296596425f\n"
"#define angle_dt 0.0314159f\n"
"\n"
"float Ts = 0.0001;\n"
"#define Ls 0.001f\n"
"#define Rs 0.0036f\n"
"#define kR 100.0f\n"
"float kpc;\n"
"struct Phase {\n"
"    float a;\n"
"    float b;\n"
"    float c;\n"
"};\n"
"struct DQ {\n"
"    float d;\n"
"    float q;\n"
"};\n"
"struct AlfaBeta {\n"
"    float alfa;\n"
"    float beta;\n"
"};\n"
"\n"
"struct ThreePhase {\n"
"    struct Phase ph;\n"
"    struct DQ dq;\n"
"    struct AlfaBeta ab;\n"
"    float RMS;\n"
"    float omega;\n"
"    float theta;\n"
"    float scale;\n"
"};\n"
"\n"
"typedef struct ThreePhase threephase;\n"
"\n"
"\n"
"threephase voltage, current_est;\n"
"\n"
"void DQ_to_AlfaBeta(threephase *x)\n"
"{\n"
"    x->ab.alfa = x->dq.d * cosf(x->theta) - x->dq.q * sinf(x->theta);\n"
"    x->ab.beta = x->dq.d * sinf(x->theta) + x->dq.q * cosf(x->theta);\n"
"}\n"
"\n"
"void AlfaBeta_to_ABC(threephase *x, float kpc)\n"
"{\n"
"    x->ph.a = kpc * x->ab.alfa;\n"
"\n"
"    x->ph.b = kpc * 0.5f * (-x->ab.alfa + sqrt3 * x->ab.beta);\n"
"\n"
"    x->ph.c = kpc * 0.5f * (-x->ab.alfa - sqrt3 * x->ab.beta);\n"
"}\n"
"\n"
"void CurrentObserverInductor(threephase *Voltage,threephase *current_est, flo"
"at Ts, float Res, float Ls_inv, float eps_dump, float kpc)\n"
"{\n"
"    float static ia_est = 0.0f;\n"
"    float static ib_est = 0.0f;\n"
"    float static ia_prev = 0.0f;\n"
"    float static ib_prev = 0.0f;\n"
"    float k1 = Ts*Ls_inv;\n"
"\n"
"    DQ_to_AlfaBeta(Voltage);\n"
"    ia_est = ia_prev + k1 * (Voltage->ab.alfa - Res*eps_dump*ia_prev);\n"
"    ib_est = ib_prev + k1 * ( Voltage->ab.beta - Res*eps_dump*ib_prev);\n"
"    ia_prev = ia_est; \n"
"    ib_prev = ib_est;\n"
"    current_est->ab.alfa = ia_est;\n"
"    current_est->ab.beta = ib_est;\n"
"    current_est->theta = atan2f(ib_est,ia_est);\n"
"    AlfaBeta_to_ABC(current_est, kpc);\n"
"    \n"
"}"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "\n"
"kpc = (1.0f/one_by_sqrt2/sqrt3);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "\n"
"\n"
"voltage.dq.d = InputSignal(1,0);\n"
"voltage.dq.q = InputSignal(1,1);\n"
"voltage.theta = InputSignal(0,0);\n"
"\n"
"\n"
"CurrentObserverInductor(&voltage, &current_est, Ts, Rs, 1/Ls, kR, kpc);\n"
"\n"
"OutputSignal(0,0) = current_est.ph.a;\n"
"OutputSignal(0,1) = current_est.ph.a;\n"
"OutputSignal(0,2) = current_est.ph.a;\n"
"\n"
"OutputSignal(1,0) = current_est.ab.alfa;\n"
"OutputSignal(1,1) = current_est.ab.beta;\n"
"\n"
"OutputSignal(2,0) = voltage.theta;\n"
"OutputSignal(2,1) = current_est.theta;\n"
"\n"
"// phase-a current and RMS\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
