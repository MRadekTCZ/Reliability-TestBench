      Parameter {
        Variable      "StartFcn"
        Value         "k1 = Ts/L;\n"
"kpc = (1.0f/INV_SQRT2/sqrt3);"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "ud = InputSignal(1,0);\n"
"uq = InputSignal(1,1);\n"
"theta = InputSignal(0,0);\n"
"\n"
"ua = ud*cosf(theta) - uq*sinf(theta);\n"
"ub = ud*sinf(theta) + uq*cosf(theta);\n"
"\n"
"ia_est = ia_prev + k1 * (ua - R*ia_prev);\n"
"ib_est = ib_prev + k1 * (ub - R*ib_prev);\n"
"ia_prev = ia_est; \n"
"ib_prev = ib_est;\n"
"ia = kpc * ia_est ;\n"
"ib = kpc * 0.5f * (-ia_est + sqrt3*ib_est);\n"
"ic = kpc * 0.5f * (-ia_est - sqrt3*ib_est);\n"
"OutputSignal(0,0) = ia;\n"
"OutputSignal(0,1) = ib;\n"
"OutputSignal(0,2) = ic;\n"
"\n"
"OutputSignal(1,0) = id;\n"
"OutputSignal(1,1) = iq;\n"
"\n"
"OutputSignal(2,0) = kpc;\n"
"\n"
"// phase-a current and RMS\n"
        Show          off
      }
