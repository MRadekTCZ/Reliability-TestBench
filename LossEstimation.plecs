    Component {
      Type          CScript
      Name          "Loss calculation RMS1"
      Show          on
      Position      [2790, 545]
      Direction     up
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         "[0 22 1536 889]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[1 1 1 1]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[1]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "0.01"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"#define ONE_BY_3PI 0.1061032954f\n"
"#define ONE_BY_4PI 0.0795774715f\n"
"#define PI 3.141592654f\n"
"#define ONE_BY_SQRT2 0.707106781f\n"
"#define PI_BY_2 1.570796327f\n"
"#define SVPWMdutyfactor 0.66667f\n"
"#define SPWMdutyfactor 0.5f\n"
"#define SVPWMcoeff 0.866f\n"
"#define TWO_BY_PI 0.636619f;\n"
"#define SQRT2 1.41421356237f\n"
"#define Afactor 1.0f\n"
"\n"
"\n"
"\n"
"\n"
"\n"
"float Im;\n"
"float ia;\n"
"float Ptotal;\n"
"float fsw = 10000.0f;\n"
"float Temperature;\n"
"float v = 25.0f;\n"
"//float Ron = 0.0195;\n"
"float Ron = 0.100;\n"
"float Rg_on = 15.0;\n"
"float Temperature;\n"
"\n"
"float RdsonTempMultiplier(float T)\n"
"{\n"
"    float k;\n"
"\n"
"    if (T <= 25.0f)\n"
"    {\n"
"        k = 1.0f;\n"
"    }\n"
"    else if (T >= 150.0f)\n"
"    {\n"
"        k = 1.1f;\n"
"    }\n"
"    else\n"
"    {\n"
"        k = 1.0f+ (T - 25.0f)* (1.1f - 1.0f)/ (150.0f - 25.0f);\n"
"    }\n"
"\n"
"    return k;\n"
"}\n"
"\n"
"float EonTempMultiplier(float T)\n"
"{\n"
"    float k;\n"
"\n"
"    if (T <= 25.0f)\n"
"    {\n"
"        k = 1.0f;\n"
"    }\n"
"    else if (T >= 150.0f)\n"
"    {\n"
"        k = 1.33f;\n"
"    }\n"
"    else\n"
"    {\n"
"        k = 1.0f\n"
"            + (T - 25.0f)\n"
"            * (1.33f - 1.0f)\n"
"            / (150.0f - 25.0f);\n"
"    }\n"
"\n"
"    return k;\n"
"}\n"
"\n"
"float LossCalc(float V, float Im, float fsw, float T)\n"
"{\n"
"    float Pcond, Eon, Eoff, Psw, Ptotal;\n"
"    float idc = fabsf(Im) * TWO_BY_PI;\n"
"\n"
"    float Ron_T = Ron * RdsonTempMultiplier(T);\n"
"\n"
"    Pcond = Ron_T * fabsf(Im) * fabsf(Im) / 4.0f;\n"
"\n"
"    //Eon = ((Rg_on-5)*0.0075+0.02)*idc*V/600/1000; //GCMX020A\n"
"    //Eon = (0.00623f + 0.11f * Rg_on)* idc / 10.0f* V / 600.0f/ 1000.0f;   /"
"/ GCMX080A\n"
"    Eon = (0.032+0.025)* idc / 10.0f/ 1000.0f *EonTempMultiplier(T) * V/70.0f"
" * V/70.0f;   // GCMX080A v2\n"
"    Eoff = 0.0f;\n"
"    Psw = fsw * (Eon + Eoff);\n"
"\n"
"    Ptotal = Pcond + Psw;\n"
"\n"
"    return Ptotal;\n"
"}\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "v = InputSignal(0,0);\n"
"Im = InputSignal(1,0);\n"
"fsw = InputSignal(2,0);\n"
"Temperature = InputSignal(3,0);\n"
"\n"
"Ptotal = LossCalc(v, Im, fsw, Temperature);\n"
"\n"
"OutputSignal(0,0) = Ptotal;\n"
"\n"
"\n"
"\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
