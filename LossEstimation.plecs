    Component {
      Type          CScript
      Name          "Current Observer open loop"
      Show          on
      Position      [520, 1665]
      Direction     up
      Flipped       off
      LabelPosition south
      CommentOut    DisabledOpenCircuit
      Parameter {
        Variable      "DialogGeometry"
        Value         "[819 251 910 586]"
        Show          off
      }
      Parameter {
